    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "antd": "^5.23.0",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.10",
    "dxf-writer": "^1.4.3",
    "harfbuzzjs": "^0.3.4",
    "i18next": "^23.16.8",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
